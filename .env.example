# Legacy-nyckel. Ger full skrivrätt och en varning i loggen.
# Stäng av med ALLOW_LEGACY_API_KEY=false när klienterna använder keys.json.
MCP_API_KEY=
ALLOW_LEGACY_API_KEY=true

# Katalogen keys/ monteras read-only. Filen inne i den är keys.json, mode 600.
# En bind-mount av själva filen gör att atomisk mv på värden inte syns i containern.
KEYS_FILE=/run/secrets/keys/keys.json

# OAuth-tokens lagras som hash. Katalogen ska vara en volym.
TOKEN_STORE_PATH=/data/oauth-tokens.json

# uvicorn --forwarded-allow-ips. Live på cloud01: caddy-proxy och hemmets edge.
FORWARDED_ALLOW_IPS=172.20.0.2,158.174.102.122

# Fernet-nyckel för Wiki.js-användar-JWT:er. Mode 600. Inte själva JWT:n.
IDENTITY_KEY_FILE=/run/secrets/identity-key
IDENTITY_STORE_DIR=/data/identities
# true: ogiltig identitet skriver med API-nyckel och en varningskommentar.
IDENTITY_FALLBACK=true
# 0 stänger schemaläggaren. 43200 är 12 timmar.
IDENTITY_RENEW_SECONDS=43200
